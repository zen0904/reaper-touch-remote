{
  "name": "reaper-touch-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first iPad touch control surface for REAPER",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node --test",
    "build:native": "sh scripts/build-native.sh",
    "check": "node --check backend/src/server.js && node --check frontend/app.js && node --test"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  }
}
